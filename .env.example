# ==============================================================================
# 🌐 1. CẤU HÌNH ỨNG DỤNG TỔNG THỂ (APPLICATION CONFIGURATION)
# ==============================================================================
# Môi trường chạy: development (lập trình cá nhân XAMPP) hoặc production (máy chủ thật)
APP_ENV=development

# Tên miền gốc chính thức của hệ thống (Không bao gồm http://, https:// hoặc dấu / ở cuối)
APP_DOMAIN=vietadvisor.test

# Tên miền phụ chuyên trách file tĩnh Cookie-Free (Không ghi http://, https:// hoặc dấu / ở cuối)
APP_ASSETS_DOMAIN=vietadvisor-assets.test

# Danh sách trắng các Host Header được phép truy cập (Chống lỗ hổng Host Header Injection)
ALLOWED_HOSTS=vietadvisor.test,vi.vietadvisor.test,ru.vietadvisor.test,vietadvisor-assets.test,localhost

# Múi giờ nền tảng cố định cho tầng xử lý logic của PHP (Dùng làm cột mốc tính toán hệ thống)
APP_TIMEZONE=Asia/Ho_Chi_Minh

# Bật/tắt chế độ chặn nghiêm ngặt các Open Proxy lậu độc hại (1: Bật, 0: Tắt)
BLOCK_MALICIOUS_PROXY=1

# Đường dẫn bảo mật trang quản trị (Có thể thay đổi liên tục để tung hỏa mù với hacker)
ADMIN_PATH=he-thong-mat-gfc2

# ==============================================================================
# 🧩 2. QUẢN LÝ KIẾN TRÚC MODULES (MODULAR ARCHITECTURE CONFIGURATION)
# ==============================================================================
# Phân hệ có cổng vào URL và giao diện người dùng (Bắt buộc phải có file routes.php con)
WEB_MODULES=Home,Insights,Advisors,Expats,Contacts

# Phân hệ chạy ngầm cung cấp dịch vụ tiện ích nội bộ (Không chứa file routes.php con)
SERVICE_MODULES=Notification,Logger,Location

# ==============================================================================
# 🗣️ 3. KIẾN TRÚC ĐA NGÔN NGỮ & GATEWAY ĐIỀU HƯỚNG (MULTILINGUAL & ONBOARDING)
# ==============================================================================
# Danh sách ngôn ngữ được chấp nhận định dạng mã_ngôn_ngữ:tên_subdomain
# Từ khóa 'root' nghĩa là chạy trực tiếp trên domain mẹ (Bản tiếng Anh mặc định)
SUPPORTED_LANGUAGES=vi:vi,ru:ru,en:root

# Ngôn ngữ đích ép buộc điều hướng khi trình duyệt của khách dùng ngôn ngữ lạ (ja, fr...)
DEFAULT_LANGUAGE=en

# ==============================================================================
# 🔒 4. CẤU HÌNH PHIÊN LÀM VIỆC & COOKIES (DYNAMIC COOKIE PROTOCOL)
# ==============================================================================
# Kiểu lưu trữ quản lý Session: files, redis, hoặc memcached
SESSION_HANDLER=files

# Đường dẫn hoặc địa chỉ IP/Giao thức lưu trữ tương ứng với kiểu xử lý:
# - Nếu SESSION_HANDLER=files     -> Để trống (Hệ thống tự động lưu vào mục templates_c/sessions)
# - Nếu SESSION_HANDLER=redis     -> tcp://127.0.0.1:6379
# - Nếu SESSION_HANDLER=memcached -> 127.0.0.1:11211
SESSION_PATH=

# Định dạng cấu trúc Cookie: ten_cookie:flag_bao_mat
# - :1 -> Tự động chèn tiền tố __Secure- khi chạy trên môi trường Production + có HTTPS
# - :0 -> Luôn luôn giữ nguyên tên thô ở mọi môi trường mạng để tối ưu giao diện UX và tài nguyên
COOKIE_SESSION_NAME=va_sess:1
COOKIE_LANG_NAME=va_lng:1
COOKIE_TIMEZONE_NAME=va_tz:0
COOKIE_THEME_NAME=va_theme:0
COOKIE_POPUP_NAME=va_popup:0

# ==============================================================================
# 📊 5. CẤU HÌNH CƠ SỞ DỮ LIỆU ĐỒNG BỘ (ILLUMINATE DATABASE / ELOQUENT ORM)
# ==============================================================================
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=vietadvisor_db
DB_USERNAME=root
DB_PASSWORD=

# ==============================================================================
# 🛡️ 6. KHÓA MÃ HÓA & TIỆN ÍCH NGOẠI VI (SECURITY KEYS & SERVICES)
# ==============================================================================
# Chuỗi Key bảo mật dùng để mã hóa dữ liệu nội bộ (Thư viện defuse/php-encryption)
APP_SECRET_KEY=defuse_crypto_hex_key_32_characters_minimum_here_

# Cấu hình cổng gửi Mail hệ thống (Thư viện phpmailer/phpmailer)
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@vietadvisor.com
MAIL_FROM_NAME="VietAdvisor Platform"

# Cấu hình Xác thực bên thứ ba (Thư viện league/oauth2-google)
GOOGLE_CLIENT_ID=your_google_client_id_://googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URL=http://vietadvisor.test

# ==============================================================================
# 🛡️ 7. TƯỜNG LỬA CHỐNG FLOOD SITE ĐỘNG VÀ QUY HOẠCH TỆP TĨNH DÙNG CHUNG
# ==============================================================================
# Cấu hình chống Flood động theo tải trọng tài nguyên
# - RATE_LIMIT_MAX_GET: Ngưỡng cho các trang xem thông tin thông thường (GET)
# - RATE_LIMIT_MAX_WRITE: Ngưỡng siết chặt cho các hành động thay đổi dữ liệu nặng (POST, PUT, DELETE, v.v.)
# - RATE_LIMIT_WINDOW: Khung thời gian theo dõi tần suất request (Tính bằng giây)
# - RATE_LIMIT_BLOCK: Thời gian phạt khóa cứng IP nếu phát hiện hành vi flood (Tính bằng giây)
RATE_LIMIT_MAX_GET=60
RATE_LIMIT_MAX_WRITE=5
RATE_LIMIT_WINDOW=10
RATE_LIMIT_BLOCK=300

# Danh sách định dạng tệp tĩnh Stateless dùng chung toàn hệ thống để tối ưu CPU miễn trừ Rate Limiter
STATIC_EXTENSIONS=css|js|gif|jpeg|jpg|png|svg|webp|ico|webmanifest|woff|woff2|ttf|eot|pdf|mp4|webm
