{
  "zones": {
    "admin": {
      "allowed_roles": ["admin"],
      "fallback_route": "auth/login",
      "error_type": "404"
    },
    "api/v1/private": {
      "allowed_roles": ["admin", "advisor", "expat"],
      "fallback_route": "api/v1/error/403",
      "error_type": "json"
    }
  },
  "modules": {
    "Advisors\\Controllers\\DashboardController": {
      "allowed_roles": ["advisor", "admin"],
      "fallback_route": "auth/login",
      "error_type": "403"
    },
    "Expats\\Controllers\\ProfileController": {
      "allowed_roles": ["expat", "admin"],
      "fallback_route": "auth/login",
      "error_type": "403"
    }
  }
}
