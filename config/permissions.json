{
    "super_admins": [
        1
    ],
    "zones": {
        "admin": {
            "required_permission": "access_admin_dashboard",
            "fallback_route": "auth/login",
            "error_type": "404"
        },
        "api/v1/private": {
            "required_permission": "access_private_api",
            "fallback_route": "api/v1/error/403",
            "error_type": "json"
        }
    },
    "modules": {
        "Advisors\\Controllers\\AdminController": {
            "required_permission": "manage_advisors",
            "fallback_route": "auth/login",
            "error_type": "403"
        },
        "Insights\\Controllers\\AdminController": {
            "required_permission": "manage_insights",
            "fallback_route": "auth/login",
            "error_type": "403"
        }
    }
}